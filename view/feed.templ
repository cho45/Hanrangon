package view

import (
	"fmt"
	"time"
	"github.com/cho45/hanrangon/model"
)

templ Feed(entries []model.Entry, updated time.Time) {
	@templ.Raw(`<?xml version="1.0" encoding="utf-8"?>`)
	<feed xmlns="http://www.w3.org/2005/Atom">
		<title>氾濫原</title>
		<link href="https://lowreal.net/"/>
		<link rel="self" type="application/atom+xml" href="https://lowreal.net/feed"/>
		<updated>{ updated.Format(time.RFC3339) }</updated>
		<author>
			<name>cho45</name>
		</author>
		<id>tag:lowreal.net,2005:feed</id>
		for _, e := range entries {
			<entry>
				<title>{ e.Title }</title>
				<link href={ templ.SafeURL(fmt.Sprintf("https://lowreal.net/%s", e.Path)) }/>
				<id>tag:lowreal.net,2005:entry:{ fmt.Sprintf("%d", e.ID) }</id>
				<updated>{ e.ModifiedAt.Format(time.RFC3339) }</updated>
				<published>{ e.CreatedAt.Format(time.RFC3339) }</published>
				<content type="html">
					{ e.FormattedBody }
				</content>
			</entry>
		}
	</feed>
}
