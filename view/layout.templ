package view

import (
	"fmt"
	"strings"

	"github.com/cho45/hanrangon/model"
)

templ Layout(title string, isAuth bool, content templ.Component) {
	<!DOCTYPE html>
	<html lang="ja" data-auth={ fmt.Sprintf("%t", isAuth) }>
	<head>
		<meta charset="utf-8"/>

		<title>{ title }</title>
		<meta name="description" content="写真・文章による、ある普通の人間の人生の記録"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=2.0, user-scalable=yes"/>
		<meta name="theme-color" content="#000000"/>

		<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin=""/>
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
		<link rel="preconnect" href="https://googleads.g.doubleclick.net" crossorigin=""/>

		<link rel="alternate" type="application/atom+xml" title="Feed" href="/feed"/>

		<meta name="referrer" content="unsafe-url"/>

		<meta itemprop="name" content="氾濫原"/>
		<meta itemprop="description" content="写真・文章による、ある普通の人間の人生の記録"/>

		<meta property="og:title" content="氾濫原"/>
		<meta property="og:type" content="blog"/>
		<meta property="og:url" content="/"/>
		<meta property="og:email" content="cho45@lowreal.net"/>
		<meta property="fb:admins" content="cho45"/>

		<link rel="stylesheet" href="/css/style.css"/>

		<script src="/js/daterelative.js" defer></script>
		<script src="/js/balancetext/tinysegmenter.js" defer></script>
		<script src="/js/balancetext/balance.js" defer></script>
		<script src="/js/abcjs_basic_5.1.1-min.js" defer></script>
		<script src="/js/nogag.js" defer></script>
	</head>
	<body>
		<header id="global-header">
			<h1 id="header">
				<a href="/">
					<img src="/images/hanrangen.svg" width="60" height="50" style="margin: auto; display: block" alt="氾濫原"/>
				</a>
			</h1>
		</header>

		<nav id="global-navigation">
			<ul>
				<li><a href="/">最新</a></li>
				<li><a href="/photo/">写真</a></li>
				<li><a href="https://www.lowreal.net/">誰？</a></li>
				if isAuth {
					<li><a href="#" class="nogag-new">新規</a></li>
					<li><a href="/logout">ログアウト</a></li>
				}
			</ul>
		</nav>

		<div id="content">
			@content
		</div>

		<footer id="global-footer">
			<h2>書いている人</h2>
			<div class="author">
				<div class="image">
					<img src="/images/profile.jpg" alt="Photo" width="160" height="160"/>
				</div>
				<div class="desc">
					<p>
						cho45 (<a href="https://www.lowreal.net/" rel="author">www.lowreal.net</a>) 
						&lt;<a href="mailto:cho45@lowreal.net">cho45@lowreal.net</a>&gt;
					</p>
					<p>
						JavaScript, Perl, Ruby, HTML, CSS, Web etc
					</p>
					<p>
						<a class="button github-button" href="https://github.com/cho45" rel="nofollow"><i></i>
							<span class="label">
								Follow <b>&#64;cho45</b>
							</span>
						</a>
					</p>
					<p>
						<a href="/archive">アーカイブ</a>
					</p>
				</div>
			</div>
		</footer>
	</body>
	</html>
}

func formatDate(dateStr string) string {
	parts := strings.Split(dateStr, "-")
	if len(parts) != 3 {
		return dateStr
	}
	return fmt.Sprintf("%s年 %s月 %s日", parts[0], parts[1], parts[2])
}

func datePath(dateStr string) string {
	return "/" + strings.ReplaceAll(dateStr, "-", "/") + "/"
}

templ Article(e model.Entry, isAuth bool, isPermalink bool) {
	{{ cleanTitle, tags := ParseTitle(e.Title) }}
	{{ canonical := "/" + e.Path }}
	<article
		id={ fmt.Sprintf("post-%d", e.CreatedAt.Unix()) }
		class={ strings.Join(tags, " ") + " status-public" }
		data-id={ fmt.Sprintf("%d", e.ID) }
		if !isPermalink {
			itemprop="blogPosts"
			itemscope
			itemtype="http://schema.org/BlogPosting"
		}
	>
		<header>
			<h2 itemprop="name"><a href={ templ.SafeURL(canonical) } class="bookmark" rel="bookmark" itemprop="url">{ cleanTitle }</a></h2>
			<div class="metadata">
				for _, tag := range tags {
					<a href={ templ.SafeURL("/" + tag + "/") }><span itemprop="keywords">{ tag }</span></a>
				}
				|
				<time data-epoch={ fmt.Sprintf("%d", e.CreatedAt.Unix()) } datetime={ e.CreatedAt.Format("2006-01-02T15:04:05") + "Z" } itemprop="datePublished">
					{ e.CreatedAt.Format("15:04") }
				</time>
				if isAuth {
					| <a href="javascript:void(0)" class="nogag-edit">編集</a>
				}
			</div>
		</header>

		<div class="content" itemprop="articleBody">
			@templ.Raw(e.FormattedBody)
		</div>

		<div class="content similar-entries"></div>

		<div class="social">
			<span class="hatena-star"></span>
			<p class="share-buttons">
				<a class="share-button" style="background: #3b5998" target="_blank" rel="noopener nofollow"
					href={ templ.SafeURL("https://www.facebook.com/sharer/sharer.php?u=" + canonical) }
				>
					<img src="/images/sharebuttons/FB-f-Logo__white_50.png" width="18" height="18" alt="Facebook"/>
				</a>
				<a class="share-button" style="background: #efefef" target="_blank" rel="noopener nofollow"
					href={ templ.SafeURL("https://bsky.app/intent/compose?text=" + cleanTitle + " " + canonical) }
				>
					<img src="/images/bluesky_media_kit_logo_svgs.svg" width="40" height="40" alt="Bluesky"/>
				</a>
				<a class="share-button" style="background: #00a4de" target="_blank" rel="noopener nofollow"
					href={ templ.SafeURL("http://b.hatena.ne.jp/add?url=" + canonical) }
				>
					<img src="/images/sharebuttons/hatenabookmark-logomark.svg" width="40" height="40" alt="はてなブックマーク"/>
				</a>
			</p>
		</div>
	</article>
}

templ EntryList(entries []model.Entry, nextPage string, isAuth bool) {
	<div class="entries">
		{{
			var ids []string
			for _, e := range entries {
				ids = append(ids, fmt.Sprintf("id=%d", e.ID))
			}
			similarURL := "/api/similar?" + strings.Join(ids, "&")
		}}
		<link rel="preload" id="preload-similar-entries" href={ templ.SafeURL(similarURL) } as="fetch" crossorigin="anonymous"/>
		for i, e := range entries {
			if i == 0 || !IsSameDay(entries[i-1].Date, e.Date) {
				<div class="date"><a href={ templ.SafeURL(datePath(e.Date)) }>{ formatDate(e.Date) }</a></div>
			}
			@Article(e, isAuth, false)
		}
	</div>

	<div class="pager">
		if nextPage != "" {
			<a href={ templ.SafeURL(nextPage) } rel="next">&#x25BC; もっと古いエントリ</a>
		}
	</div>
}

templ EntryDetail(entry model.Entry, prev, next *model.Entry, isAuth bool) {
	<div class="entries">
		<link rel="preload" id="preload-similar-entries" href={ templ.SafeURL(fmt.Sprintf("/api/similar?id=%d", entry.ID)) } as="fetch" crossorigin="anonymous"/>
		<div class="date"><a href={ templ.SafeURL(datePath(entry.Date)) }>{ formatDate(entry.Date) }</a></div>
		@Article(entry, isAuth, true)
	</div>

	<div class="pager">
		if next != nil {
			<a href={ templ.SafeURL("/" + next.Path) } rel="prev"> { next.Title } &#x25B6;</a>
		}
		if prev != nil {
			<a href={ templ.SafeURL("/" + prev.Path) } rel="next">&#x25C0; { prev.Title }</a>
		}
	</div>
}

templ Index(entries []model.Entry, nextPage string, isAuth bool) {
	@Layout("氾濫原", isAuth, EntryList(entries, nextPage, isAuth))
}

templ Entry(entry model.Entry, prev, next *model.Entry, isAuth bool) {
	@Layout(entry.Title + " - 氾濫原", isAuth, EntryDetail(entry, prev, next, isAuth))
}